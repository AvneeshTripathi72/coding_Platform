# Environment
NODE_ENV=production
PORT=3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
SESSION_SECRET=your_session_secret_key

# Redis (Upstash / Redis Cloud for serverless)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# OR discrete parameters:
# REDIS_HOST=
# REDIS_PORT=
# REDIS_USERNAME=
# REDIS_PASSWORD=

# AI Services (Groq & Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Judge0 (Code Execution through RapidAPI)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com/submissions/batch
JUDGE0_RAPIDAPI_KEY=your_rapidapi_key
JUDGE0_RAPID_HOST=judge0-ce.p.rapidapi.com

# Cloudinary (Video Storage & Streaming)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=code_arena_videos

# DodoPayments (Subscription & Checkout)
DODO_API_KEY=your_dodo_api_key
DODO_ENV=live_mode
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PRODUCT_MONTHLY_ID=prod_monthly_id
DODO_PRODUCT_YEARLY_ID=prod_yearly_id

# Frontend Origins & CORS
FRONTEND_URL=https://code-verse.vercel.app
ADMIN_FRONTEND_URL=https://code-verse-admin.vercel.app
BACKEND_URL=https://code-verse-api.vercel.app
ALLOWED_ORIGINS=https://code-verse.vercel.app,https://code-verse-admin.vercel.app,http://localhost:5173,http://localhost:5174

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
